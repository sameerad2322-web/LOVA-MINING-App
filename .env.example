# ==============================================================================
# LOVA MINING — ENVIRONMENT VARIABLES TEMPLATE
# Never commit real secrets to source control.
# ==============================================================================

# Server / Public HTTPS App URL (e.g. https://lova-mining.pages.dev or https://lova-mining.<subdomain>.workers.dev)
APP_URL="http://localhost:3000"
PORT="3000"

# Database:
# - Production (Cloudflare Workers / Pages): Cloudflare D1 SQLite via `DB` binding in wrangler.toml / wrangler.worker.toml
# - Local Dev / Node Express Server: Automatically stores data in `.data/lova-d1.sqlite` using Node SQLite D1 emulator

# Telegram Mini App Bot (SERVER-ONLY — NEVER EXPOSE TO CLIENT)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Set to "true" ONLY for local preview testing outside Telegram WebApp.
# Must be "false" in production (Cloudflare Pages / Workers) so only HMAC-verified initData is accepted.
TELEGRAM_ALLOW_DEV_PREVIEW="true"

# Server Session & Admin Security (SERVER-ONLY)
# Generate random 32+ char strings in production (e.g. openssl rand -hex 32)
SESSION_SECRET=""
ADMIN_BOOTSTRAP_SECRET=""
# Comma-separated Telegram User IDs allowed to access /admin (Admin Panel Mode)
ADMIN_TELEGRAM_IDS=""

# TON Blockchain & 0.05 GRAM KYC Verification (SERVER-ONLY API KEY)
# Required for live on-chain 0.05 GRAM KYC verification before withdrawals
GRAM_JETTON_MASTER_ADDRESS=""
GRAM_JETTON_DECIMALS="9"
ADMIN_TON_WALLET_ADDRESS=""
TON_API_ENDPOINT="https://tonapi.io/v2"
TON_API_KEY=""

# Live LOVA Jetton Contract & Admin Level-Up Receiving Wallet on TON
LOVA_JETTON_MASTER_ADDRESS=""
LOVA_JETTON_DECIMALS="9"
ADMIN_LOVA_WALLET_ADDRESS=""
